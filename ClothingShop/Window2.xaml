<Window x:Class="ClothingShop.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClothingShop"
        mc:Ignorable="d"
        Title="Добавление" Width="400" Height="350">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Наименование" Margin="8,8,0,0"/>
            <TextBox x:Name="Name" Width="230" Height="25" Margin="52.5,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Категория" Margin="8,8,0,0"/>
            <ComboBox x:Name="Category" Width="230" Height="25" Margin="79.0,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Размер" Margin="8,8,0,0"/>
            <ComboBox x:Name="Size" Width="230" Height="25" Margin="95.5,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Цена" Margin="8,8,0,0"/>
            <TextBox x:Name="Price" Width="230" Height="25" Margin="107,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Количество на складе" Margin="8,8,0,0"/>
            <TextBox x:Name="StockQuantity" Width="230" Height="25" Margin="15,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Сезон" Margin="8,8,0,0"/>
            <ComboBox x:Name="Season" Width="230" Height="25" Margin="102,8,0,0"/>
        </StackPanel>
        <TextBlock x:Name="VseDannie" Margin="5,10,5,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
            <Button Content="Сохранить" Margin="85,0,0,0" Padding="10,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Отмена" Margin="45,0,0,0" Padding="19,15,19,15" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
