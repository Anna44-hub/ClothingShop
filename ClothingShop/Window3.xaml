<Window x:Class="ClothingShop.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ClothingShop"
        mc:Ignorable="d"
        Title="Добавление" Width="400" Height="350">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Поставщик" Margin="8,8,0,0"/>
            <TextBox x:Name="Provider" Width="230" Height="25" Margin="80,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Дата поставки" Margin="8,8,0,0"/>
            <TextBox x:Name="DateOfDelivery" Width="230" Height="25" Margin="63,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Товар" Margin="8,8,0,0"/>
            <TextBox x:Name="Name" Width="230" Height="25" Margin="109,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Количетво" Margin="8,8,0,0"/>
            <TextBox x:Name="Quantity" Width="230" Height="25" Margin="83,8,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Стоимость поставки" Margin="8,8,0,0"/>
            <TextBox x:Name="CostOfDelivery" Width="230" Height="25" Margin="30,8,0,0"/>
        </StackPanel>
        <TextBlock x:Name="VseDannie" Margin="5,10,5,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,15,0,0" >
            <Button Content="Сохранить" Margin="85,0,0,0" Padding="10,0,10,0" Click="SaveButton_Click"/>
            <Button Content="Отмена" Margin="45,0,0,0" Padding="19,15,19,15" Click="CancelButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
